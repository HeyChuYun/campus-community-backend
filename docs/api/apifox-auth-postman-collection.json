    { "key": "nickname", "value": "测试用户" },
    { "key": "studentNo", "value": "202304032023" },
    { "key": "schoolPassword", "value": "your-school-password" },
    { "key": "captchaCode", "value": "1234" },
    { "key": "authSessionId", "value": "" },
    { "key": "captchaImageBase64", "value": "" },
    { "key": "schoolAuthTicket", "value": "" },
    { "key": "studentName", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "deviceHeader", "value": "flutter/android-test" },
    { "key": "captchaId", "value": "" },
    { "key": "lotNumber", "value": "" },
    { "key": "captchaOutput", "value": "" },
    { "key": "passToken", "value": "" },
