  "item": [
    {
      "name": "BehaviorVerify",
      "item": [
        {
          "name": "Get Behavior Config",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.code === 0 && body.data) {",
                  "  pm.collectionVariables.set('captchaId', body.data.captcha_id || '');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/behaviorConfig",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "behaviorConfig"]
            },
            "description": "获取登录/注册前端需要使用的极验公开配置。"
          },
          "response": []
        }
      ]
    },
    {
      "name": "SchoolAuth",
      "item": [
        {
          "name": "PreAuthorize",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.code === 0 && body.data) {",
                  "  pm.collectionVariables.set('authSessionId', body.data.auth_session_id || '');",
                  "  pm.collectionVariables.set('captchaImageBase64', body.data.captcha_image_base64 || '');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/school/preAuthorize",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "school", "preAuthorize"]
            }
          },
          "response": []
        },
        {
          "name": "Authorize",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.code === 0 && body.data) {",
                  "  pm.collectionVariables.set('schoolAuthTicket', body.data.school_auth_ticket || '');",
                  "  pm.collectionVariables.set('studentNo', body.data.student_no || '');",
                  "  pm.collectionVariables.set('studentName', body.data.student_name || '');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"auth_session_id\": \"{{authSessionId}}\",\n  \"student_no\": \"{{studentNo}}\",\n  \"school_password\": \"{{schoolPassword}}\",\n  \"captcha_code\": \"{{captchaCode}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/school/authorize",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "school", "authorize"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.code === 0 && body.data) {",
                  "  const user = body.data.user || {};",
                  "  const tokens = body.data.tokens || {};",
                  "  pm.collectionVariables.set('userId', String(user.user_id || ''));",
                  "  pm.collectionVariables.set('accessToken', tokens.access_token || '');",
                  "  pm.collectionVariables.set('refreshToken', tokens.refresh_token || '');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Device", "value": "{{deviceHeader}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account\": \"{{account}}\",\n  \"password\": \"{{password}}\",\n  \"nickname\": \"{{nickname}}\",\n  \"school_auth_ticket\": \"{{schoolAuthTicket}}\",\n  \"behavior_verify\": {\n    \"lot_number\": \"{{lotNumber}}\",\n    \"captcha_output\": \"{{captchaOutput}}\",\n    \"pass_token\": \"{{passToken}}\",\n    \"gen_time\": \"{{genTime}}\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "register"]
            }
          },
          "response": []
        },
