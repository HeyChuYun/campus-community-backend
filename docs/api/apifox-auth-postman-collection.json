    {
      "name": "Admin",
      "item": [
        {
          "name": "Assign User Roles",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "X-Request-Timestamp", "value": "{{$timestamp}}" },
              { "key": "X-Request-Nonce", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"target_user_id\": {{targetUserId}},\n  \"role_codes\": [\"admin\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/users/roles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "users", "roles"]
